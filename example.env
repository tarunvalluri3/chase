# ---- Server (server/.env) ----
NODE_ENV=development
PORT=8080

# ---- Database: Supabase Postgres, accessed directly via pg (NO ORM) ----
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# (optional discrete alternatives if you don't use DATABASE_URL)
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres

# ---- Clerk (backend) ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ---- Frontend (client/.env) ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_CLERK_PUBLISHABLE_KEY=

# ---- Optional extras (only if Supabase client SDK is ever needed) ----
# The primary DB access path is `pg` via DATABASE_URL above. These are
# NOT required and should stay commented out unless a future phase
# explicitly decides to use the Supabase JS client.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
