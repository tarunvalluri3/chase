# ---- Server (server/.env) ----
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# ---- Database: Supabase, accessed via @supabase/supabase-js (NO ORM, NO pg) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clerk (backend) ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Deployed frontend origin, used to build links inside email bodies.
CLIENT_URL=http://localhost:5173
# Both optional -- sane defaults apply if unset.
NOTIFICATION_SWEEP_INTERVAL_MINUTES=5
DEADLINE_REMINDER_HOURS_BEFORE=24

# ---- Push notifications (Web Push / VAPID) ----
# Generate once with `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a
# mailto: or https: contact URL required by the Web Push protocol.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ---- Frontend (client/.env) ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_CLERK_PUBLISHABLE_KEY=
